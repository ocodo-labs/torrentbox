      "ass",
      "ssa",
      "vtt",
      "sub",
      "idx",
      "smi",
      "sbv"
    ]
  },
  "classification": {
    "precedence": [
      "tv",
      "movie",
      "unknown"
    ],
    "tv": {
      "positive_markers": [
        "tv.season_episode"
      ]
    },
    "movie": {
      "positive_markers": [
        "movie.year"
      ]
    }
  },
  "formatting": {
    "title": {
      "capitalize_words": true,
      "collapse_whitespace": true,
      "strip_whitespace": true
    },
    "movie": {
      "year": {
        "enabled": true,
        "prefix": " (",
        "suffix": ")"
      }
    },
    "tv": {
      "season_prefix": "S",
      "episode_prefix": "E",
      "season_digits": 2,
      "episode_digits": 2
    }
  },
  "behavior": {
    "normalize_separators": true,
    "title_boundary_on_positive_match": true,
    "remove_noise_before_positive_match": true,
    "tv_before_year": true,
    "year_without_episode_is_movie": true,
    "preserve_extension": true,
    "subtitle_follows_media_name": true
  }
}