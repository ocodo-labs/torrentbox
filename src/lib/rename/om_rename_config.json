  "noise_patterns": [
    "\\b\\d{3,4}p\\b",
    "\\b\\d{3,4}i\\b",
    "\\b\\d{3,4}x\\d{3,4}\\b",
    "\\b\\d{2,3}(?:\\.\\d+)?fps\\b",
    "\\b\\d+(?:\\.\\d+)?(?:kbps|mbps)\\b",
    "\\b(?:44\\.1|48|96|192)khz\\b",
    "\\b(?:1|2|5|7)\\.\\d\\b",
    "\\b(?:cd|disc|disk)[ ._-]?\\d+\\b",
    "\\bpart[ ._-]?\\d+\\b",
    "\\bvol(?:ume)?[ ._-]?\\d+\\b",
    "\\[(?:1080p|720p|2160p|4k|8k)\\]"
  ],
  "extensions": {
    "other_extensions": "other_extensions.txt",
    "video": [
      "mp4",
      "mkv",
      "avi",
      "mov",
      "m4v",
      "wmv",
      "mpg",
      "mpeg",
      "ts",
